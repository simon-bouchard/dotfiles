alias la='ls -a'
alias sl='ls'
alias dc='cd'
alias v="nvim"
alias ..="cd .."
alias ...="cd ../.."
alias c="cat"
alias t="tmux"
alias ta="tmux attach"
alias tat="tmux attach-session -t"
alias tls="tmux list-sessions"
alias cr="claude --resume"
alias so="source"
alias tl="tail -f"
alias glow="glow -s ~/.config/glow/no-margin.json"

# Python Stuff
alias python='python3'
alias py='python3'
alias pip='pip3'
alias uvr="uvicorn main:app --reload"
alias uvi="uvicorn"

# Docker Aliases
alias dk="docker"

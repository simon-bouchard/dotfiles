# Git Aliases
alias ga="git add"
alias gaa="git add -A"
alias gc="git commit -m"
alias gps="git push"
alias gpl="git pull"
alias gs="git status"
alias gl="git log --oneline --graph --decorate"
alias gco="git checkout"
alias gsw="git switch"
alias gb="git branch"
alias gm="git merge"

# Interactive rebase: `grbi 3` rebases the last 3 commits, other args pass through
# (replaces oh-my-zsh's grbi alias, which would otherwise block the function definition)
unalias grbi 2>/dev/null
grbi() {
    if [[ "$1" == <-> ]]; then
        git rebase -i "HEAD~$1" "${@:2}"
    else
        git rebase -i "$@"
    fi
}

# C++ Aliases
alias g++="g++ -std=c++23"
alias c++="c++ -std=c++23"

# Custom Commands and Scripts Aliases
alias xcopy='xclip -selection clipboard -i && sleep 0.1'

xcopylarge() {
    xclip -selection clipboard -i < "$1"
    echo "Copied $(wc -c < "$1") bytes to clipboard"
}

# Server Admin Aliases
alias jl="journalctl -u"
alias jlf="journalctl -f"
alias sc="systemctl"
alias scu="systemctl --user"
alias scs="systemctl status"

jlog() {
    local service="$1"
    local lines="$2"

    if [ -z "$service" ]; then
        echo "Usage: jlog <service> [lines]"
        return 1
    fi

    if [ -z "$lines" ]; then
        lines=100
    fi

    journalctl -u "$service.service" -n "$lines" --no-pager -o cat
}

# C++ functions
cppsan() {
    if [ -z "$1" ]; then
        echo "usage: cppsan <file.cpp>"
        return 1
    fi
    g++-14 -std=c++23 -Wall -Wextra -fsanitize=address,undefined -o a.out "$1" && ./a.out
}

# nvm: put the newest installed node on PATH directly, load nvm itself on first use
export NVM_DIR="$HOME/.nvm"
_node_bin=($NVM_DIR/versions/node/v*/bin(N/nOn[1]))
(( $#_node_bin )) && path=($_node_bin $path)
unset _node_bin
nvm() {
    unset -f nvm
    source "$NVM_DIR/nvm.sh"
    nvm "$@"
}

# Starship Prompt
eval "$(starship init zsh)"

# Vi-mode cursor on mode switch. Set as a plain widget after starship (instead of a zle hook)
# so starship's own keymap-select wrapping can't recurse; reset-prompt is what starship's did.
_vi_keymap_select() {
    _vi_cursor
    zle reset-prompt
}
zle -N zle-keymap-select _vi_keymap_select

# Direnv
export DIRENV_LOG_FORMAT=""
eval "$(direnv hook zsh)"

# Zoxide (smart cd)
eval "$(zoxide init zsh)"

# Swallow terminal focus reports (ESC[I / ESC[O) left on by tmux focus-events. Unbound in vi
# mode they read as ESC (command mode) + "I"/"O", scrambling the next input.
_focus_event_noop() { :; }
zle -N _focus_event_noop
for _km in viins vicmd; do
    bindkey -M $_km '^[[I' _focus_event_noop
    bindkey -M $_km '^[[O' _focus_event_noop
done
unset _km

# Add global ruff configuration
export RUFF_CONFIG="$HOME/.config/ruff/ruff.toml"

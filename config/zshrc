# Swallow terminal focus-in/out reporting (ESC[I / ESC[O). tmux's
# focus-events option (enabled unconditionally by tmux-sensible, for vim's
# autoread) can leave the outer terminal emitting these after detach. With
# vi keybindings, an unbound ESC[I is read as bare ESC (-> vi command mode)
# followed by literal "I" (vi's "insert at start of line"), scrambling
# whatever gets typed next. Binding the full sequence makes zle consume it
# as one unit instead of falling back to that per-byte reinterpretation.
_focus_event_noop() { :; }
zle -N _focus_event_noop
bindkey -M viins '^[[I' _focus_event_noop
bindkey -M viins '^[[O' _focus_event_noop
bindkey -M vicmd '^[[I' _focus_event_noop
bindkey -M vicmd '^[[O' _focus_event_noop

# tmux's `set -g mouse on` enables xterm any-motion mouse tracking
# (ESC[?1003h) on the outer terminal. tmux is supposed to disable it again
# on detach, but on this tmux version that doesn't always happen reliably,
# so the terminal keeps reporting every mouse move as a raw ESC[M<button>
# <x><y> triplet straight into the bare zsh prompt (shows up as garbage
# like a literal "C" plus unprintable bytes). Re-sending the disable codes
# before every prompt is a no-op if tracking was never left on, so it's
# safe to run unconditionally -- only needed outside tmux, where tracking
# is intentionally active.
if [[ -z "$TMUX" ]]; then
    _reset_stray_mouse_tracking() {
        printf '\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?1015l'
    }
    autoload -Uz add-zsh-hook
    add-zsh-hook precmd _reset_stray_mouse_tracking
fi


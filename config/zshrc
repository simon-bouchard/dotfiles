# PATH: typeset -U drops duplicates, (N/) skips directories that don't exist
typeset -U path
path=($HOME/bin(N/) $HOME/.local/bin /usr/local/bin /snap/bin(N/) $path)

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

#enable vim keybindings
bindkey -v

# Prompt custom
PS1='%F{red}%*%f %F{blue}%m%f %F{green}%~%f %F{red}>%f%F{blue}>%f%F{green}>%f '

# Syntax highlighting last so it wraps the final widgets. zsh-autocomplete is sourced
# separately below, not listed here.
plugins=(
  git
  zsh-completions
  zsh-autosuggestions
  fast-syntax-highlighting
)

zstyle ':autocomplete:*' ignored-input 'direnv: *'

# Machine-specific settings (untracked, see templates/zshrc.local.example). Sourced before
# oh-my-zsh so it can adjust fpath, compinit and STARSHIP_CONFIG.
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# zsh-autocomplete must load before any compinit call, but oh-my-zsh runs compinit before
# sourcing its plugins. Source it first: it runs its own compinit and turns oh-my-zsh's into
# a no-op. It also has to precede zsh-autosuggestions, whose ZSH_AUTOSUGGEST_* options it sets.
# Its zasync dependency (cloned into the cache on first run) goes on fpath first: on zsh 5.8 the
# plugin's own fallback autoload silently leaves zasync an empty function, so no list ever shows.
fpath=(${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zasync(N/) $fpath)
source $ZSH/custom/plugins/zsh-autocomplete/zsh-autocomplete.plugin.zsh

# zsh-autocomplete binds these keys now but defines the widgets at the first prompt, which makes
# fast-syntax-highlighting warn "unhandled ZLE widget". Placeholders it replaces at that prompt.
_autocomplete_placeholder() { :; }
zle -N menu-search _autocomplete_placeholder
zle -N recent-paths _autocomplete_placeholder

#source oh-my-zsh
source $ZSH/oh-my-zsh.sh

# oh-my-zsh's lib/key-bindings.zsh runs `bindkey -e`, overriding the `bindkey -v` above.
# Re-assert vi mode now that it has loaded.
bindkey -v

# zsh-autocomplete binds its menu arrow keys on `main` while it is still aliased to emacs,
# so viins never gets them. Rebind explicitly.
bindkey -M viins '^[[A' up-line-or-search
bindkey -M viins '^[OA' up-line-or-search
bindkey -M viins '^[[B' down-line-or-select
bindkey -M viins '^[OB' down-line-or-select
bindkey -M viins '^R' history-incremental-search-backward
bindkey -M viins '^S' menu-search

# Switch modes on Esc without the default 0.4s wait for a multi-key sequence
KEYTIMEOUT=1

# Cursor shows the vi mode: bar in insert, block in command mode and while commands run
_vi_cursor() {
    if [[ $KEYMAP == vicmd ]]; then
        printf '\e[2 q'
    else
        printf '\e[6 q'
    fi
}
_block_cursor() { printf '\e[2 q'; }
autoload -Uz add-zle-hook-widget
add-zle-hook-widget line-init _vi_cursor
add-zle-hook-widget line-finish _block_cursor

# Ctrl-Backspace: word delete in vi insert mode (terminals send ^H or ESC-DEL)
bindkey -M viins '^H' vi-backward-kill-word
bindkey -M viins '^[^?' vi-backward-kill-word


# Add local bin directories to PATH
# The n-managed node install lives separately from the standalone
# /usr/local/bin/node binary and is the only place npm/npx are actually
# installed -- prepend it so it wins and node/npm/npx all resolve together.
export PATH="/usr/local/n/versions/node/18.16.0/bin:$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH"

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

#enable vim keybindings
bindkey -v

# Ctrl-Backspace sends ^H (not DEL like plain Backspace). zsh vi mode binds
# ^H to vi-backward-delete-char (single char) by default; rebind it to word
# delete to match ^W. (The equivalent readline binding lives in ~/.inputrc,
# which only applies to bash/readline programs, not zsh's line editor.)
bindkey -M viins '^H' vi-backward-kill-word

# Prompt custom
PS1='%F{red}%*%f %F{blue}%m%f %F{green}%~%f %F{red}>%f%F{blue}>%f%F{green}>%f '

zstyle ':completion:*' use-cache on
ZSH_DISABLE_COMPFIX=true

plugins=(
  git
  zsh-autosuggestions
  fast-syntax-highlighting
  zsh-autocomplete
  zsh-history-substring-search
  zsh-completions
)

zstyle ':autocomplete:*' ignored-input 'direnv: *'

#source oh-my-zsh
ZSH_DISABLE_COMPFIX=true
skip_global_compinit=1

# /usr/share/zsh/vendor-completions/_antigravity is owned by root and we
# have no sudo, so `compaudit` always flags it. ZSH_DISABLE_COMPFIX only
# guards Oh My Zsh's OWN compinit call, not zsh-autocomplete's separate
# internal one, and a `-u` flag only silences the audit for a single
# invocation, not for later calls made by other plugins.
#
# Simplest fix: drop the offending directory from $fpath entirely, before
# ANY compinit call happens. compaudit only flags directories it's asked to
# scan, so if it's not in $fpath, nothing will ever prompt about it, no
# matter who runs compinit or how many times.
fpath=(${fpath:#/usr/share/zsh/vendor-completions})

source $ZSH/oh-my-zsh.sh

# oh-my-zsh's lib/key-bindings.zsh unconditionally calls `bindkey -e`,
# which runs after (and wins over) the `bindkey -v` above, silently
# switching the shell's actual active keymap to emacs no matter what
# was set earlier. Re-assert vi mode here so it actually sticks; this
# just re-links `main` to the already-customized `viins`/`vicmd`
# keymaps, it doesn't wipe bindings set on them earlier in this file.
bindkey -v

# zsh-autocomplete's arrow keys for navigating its live suggestion menu
# (down-line-or-select / up-line-or-search) are bound with `bindkey -M
# main ...`, not `-M viins` (see its Functions/Init/.autocomplete__key-
# bindings). That runs while oh-my-zsh.sh is sourced above, at which point
# `main` is still aliased to `emacs` (oh-my-zsh's key-bindings.zsh aliased
# it there before plugins loaded), so the bindings land in the emacs
# keymap. The `bindkey -v` just above re-aliases `main` -> `viins`, but
# that doesn't retroactively move bindings already written into emacs's
# table, so viins -- the keymap actually active while typing -- never
# gets them, and the arrow keys fall back to default vi-mode behavior
# instead of moving through the suggestion menu. Rebind them explicitly.
bindkey -M viins '^[[A' up-line-or-search
bindkey -M viins '^[OA' up-line-or-search
bindkey -M viins '^[[B' down-line-or-select
bindkey -M viins '^[OB' down-line-or-select


# --- Tokyo Night terminal colors (VTE escape sequences) ---
# Sets background/foreground/16-color ANSI palette directly via OSC codes.
# Works regardless of GNOME Terminal profile settings. Only runs in
# interactive shells inside a real terminal (skips e.g. tmux control mode,
# non-interactive scripts, dumb terminals). Skipped inside tmux: $TERM there
# is tmux-256color (not "dumb"), so without this check the block re-fires on
# every new pane/window; sent raw (unwrapped in tmux's passthrough escape)
# that can leave stray bytes that land as garbage input in the pane. The
# outer, non-tmux shell already sets these once before you attach/create
# tmux panes, so re-running inside tmux is redundant anyway.
if [[ $- == *i* && -t 1 && "$TERM" != "dumb" && -z "$TMUX" ]]; then
    # Background / foreground / cursor
    printf '\033]11;#1a1b26\007'   # background (Tokyo Night NIGHT - darkest variant)
    printf '\033]10;#c0caf5\007'   # foreground
    printf '\033]12;#c0caf5\007'   # cursor

    # ANSI 0-15 palette (night variant)
    printf '\033]4;0;#15161e\007'
    printf '\033]4;1;#f7768e\007'
    printf '\033]4;2;#9ece6a\007'
    printf '\033]4;3;#e0af68\007'
    printf '\033]4;4;#7aa2f7\007'
    printf '\033]4;5;#bb9af7\007'
    printf '\033]4;6;#7dcfff\007'
    printf '\033]4;7;#a9b1d6\007'
    printf '\033]4;8;#414868\007'
    printf '\033]4;9;#f7768e\007'
    printf '\033]4;10;#9ece6a\007'
    printf '\033]4;11;#e0af68\007'
    printf '\033]4;12;#7aa2f7\007'
    printf '\033]4;13;#bb9af7\007'
    printf '\033]4;14;#7dcfff\007'
    printf '\033]4;15;#c0caf5\007'
fi
# --- end Tokyo Night terminal colors ---

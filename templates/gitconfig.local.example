# Machine-specific git config - not tracked by the dotfiles repo.
# Copied once to ~/.gitconfig.local by symlink.sh, then yours to edit freely.

[user]
	name = Your Name
	email = your.email@example.com

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

# Uncomment if git complains about "dubious ownership" for a repo on this machine:
# [safe]
# 	directory = /home/you/dotfiles

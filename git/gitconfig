[core]
	excludesfile = ~/.gitignore_global

[color]
    ui = auto

[core]
  autocrlf = true

[alias]
    co = checkout
	a = add -A
    cm = commit
	c = commit -m
	p = push
    st = status
    br = branch
	graph = log --all --graph --decorate --oneline
	ts = status

[merge]
tool = meld

[url "git@github.com:"]
	pushInsteadOf = https://github.com/

[include]
	path = ~/.gitconfig.local

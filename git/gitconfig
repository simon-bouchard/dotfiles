[core]
	excludesfile = ~/.gitignore_global
	autocrlf = input
	editor = nvim

[color]
    ui = auto

[alias]
    co = checkout
	a = add -A
    cm = commit
	c = commit -m
	p = push
    st = status
    br = branch
	graph = log --all --graph --decorate --oneline
	ts = status

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[pull]
	rebase = true

[rerere]
	enabled = true

[diff]
	algorithm = histogram

[url "git@github.com:"]
	pushInsteadOf = https://github.com/

[include]
	path = ~/.gitconfig.local
